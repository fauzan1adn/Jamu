# TEMPLATE: salin menjadi .env lalu isi akun sendiri.
# Akun tambahan yang tidak dipakai: biarkan dikomentari (#).
# Webhook opsional per akun: kosong = tidak kirim notifikasi.
# Jika password mengandung # atau spasi, bungkus dengan tanda kutip.

# ===== AKUN 1 =====
NH_EMAIL=akun1@example.com
NH_PASSWORD="ganti_password_akun1"
NH_SERVER=1
DISCORD_WEBHOOK_URL=

# ===== AKUN 2 =====
# Hapus # pada tiga baris NH berikut untuk mengaktifkan akun 2.
# NH_EMAIL_2=akun2@example.com
# NH_PASSWORD_2="ganti_password_akun2"
# NH_SERVER_2=45
DISCORD_WEBHOOK_URL_2=

# ===== AKUN 3 =====
# Hapus # pada tiga baris NH berikut untuk mengaktifkan akun 3.
# NH_EMAIL_3=akun3@example.com
# NH_PASSWORD_3="ganti_password_akun3"
# NH_SERVER_3=1
DISCORD_WEBHOOK_URL_3=

# Untuk akun berikutnya, salin blok akun 3 dan ganti _3 menjadi _4, _5, dst.
# Gunakan email login berbeda untuk setiap akun.
